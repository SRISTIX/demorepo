FLOOR_ROOMS={
    1:[("Library",C["accent"]),("Hallway A",C["text3"]),("Cafeteria",C["accent2"])],
    2:[("Hallway B",C["text3"]),("Bus Bay",C["warn"]),("Locker Bay",C["text3"])],
    3:[("Gym",C["accent3"]),("Art Room",C["accent"]),("Stairwell",C["text3"])],
    4:[("Chem Lab",C["accent2"]),("Server Rm",C["accent"]),("Detention",C["warn"])],
    5:[("Records",C["accent"]),("Counselor",C["warn"]),("Boiler Rm",C["text3"])],
    6:[("Principal",C["accent2"]),("Archives",C["accent"]),("Staff Rm",C["text3"])],
    7:[("Roof Acc.",C["text3"]),("CCTV Rm",C["accent"]),("Storage",C["warn"])],
    8:[("Attic",C["warn"]),("Loop Hall",C["accent2"]),("Sealed Rm",C["text3"])],
    9:[("Clock Twr",C["accent"]),("Obs. Deck",C["accent2"]),("Void Stair",C["text3"])],
    10:[("Charter Rm",C["accent2"]),("Exit???",C["accent3"]),("Endgame",C["red"])],
}

class SchoolMap:
    FH=46
    def draw(self,surf,current,rect,visited,tasks_done:set):
        _draw_panel(surf,rect,C["surface"],radius=8)
        font=FONTS.get("small",FONTS["body"])
        surf.blit(font.render("BLACKWELL",True,C["text3"]),(rect.x+8,rect.y+6))
        vis=8; end=min(10,current+vis//2); start=max(1,end-vis+1); end=min(10,start+vis-1)
        for i,fl in enumerate(range(end,start-1,-1)):
            fy=rect.y+28+i*self.FH; fx=rect.x+6; fw=rect.w-12
            is_cur=(fl==current); is_vis=fl in visited; is_done=fl in tasks_done
            bg=(C["surface2"] if is_cur else (C["surface"] if not is_vis else (18,20,32)))
            bc=(C["accent"] if is_cur else C["accent3"] if is_done else C["border"])
            fr=pygame.Rect(fx,fy,fw,self.FH-4)
            pygame.draw.rect(surf,bg,fr,border_radius=5)
            pygame.draw.rect(surf,bc,fr,1 if not is_cur else 2,border_radius=5)
            fc=(C["accent"] if is_cur else C["text2"] if is_vis else C["text3"])
            tf=FONTS.get("small",FONTS["body"])
            surf.blit(tf.render(f"F{fl:02d}",True,fc),(fx+4,fy+(self.FH-4)//2-7))
            # Task-done checkmark
            if is_done:
                surf.blit(FONTS.get("tiny",FONTS["body"]).render("✓",True,C["accent3"]),(fx+fw-18,fy+8))
            for ri,(rn,rc) in enumerate(FLOOR_ROOMS.get(fl,[])):
                rx=fx+36+ri*78; rr=pygame.Rect(rx,fy+5,74,self.FH-14)
                rb=rc if is_cur else _dk(rc,0.5)
                pygame.draw.rect(surf,rb,rr,border_radius=3)
                surf.blit(FONTS.get("tiny",FONTS["body"]).render(rn,True,C["text"] if is_cur else C["text3"]),(rx+3,fy+(self.FH-4)//2-6))
            if is_cur:
                ax=rect.right-16; ay=fy+self.FH//2-6
                pygame.draw.polygon(surf,C["accent"],[(ax,ay),(ax+10,ay+6),(ax,ay+12)])


# ═══════════════════════════════════════════════════════════════════════
#  TRANSITION
# ═══════════════════════════════════════════════════════════════════════

class Transition:
    DUR=0.26
    def __init__(self): self._a=0; self._on=False; self._el=0.0
    def start(self): self._a=255; self._on=True; self._el=0.0
    @property
    def done(self): return not self._on
    def update(self,dt):
        if not self._on: return
        self._el+=dt; self._a=max(0,int(255*(1-self._el/self.DUR)))
        if self._a==0: self._on=False
    def draw(self,surf):
        if self._a<=0: return
        ov=pygame.Surface((W,H)); ov.set_alpha(self._a); ov.fill(C["bg"]); surf.blit(ov,(0,0))


# ═══════════════════════════════════════════════════════════════════════
#  SCENES
# ═══════════════════════════════════════════════════════════════════════

class TitleScene:
    def __init__(self,game):
        self.game=game; self.name=""; self._cursor=True; self._ct=0.0; self._bt=0.0
        self._arch=SchoolArchitecture()
        self.orbs=[{"x":random.randint(50,W-50),"y":random.randint(50,H-50),
                    "r":random.randint(60,160),"col":random.choice([C["accent"],C["accent2"],C["accent3"]]),
                    "dx":random.uniform(-.3,.3),"dy":random.uniform(-.3,.3),"a":random.randint(10,25)}
                   for _ in range(5)]
        cx=W//2
        self.btn_start=Button((cx-130,510,260,48),"ENTER BLACKWELL","primary","head","nav")
        self.btn_customize=Button((cx-130,568,260,40),"Customize Character","ghost","body","ui")
        self.btn_quit=Button((cx-70,618,140,34),"Quit","ghost","small","ui")

    def handle_event(self,event):
        if event.type==pygame.KEYDOWN:
            if event.key==pygame.K_BACKSPACE: self.name=self.name[:-1]
            elif event.key==pygame.K_RETURN: self._start()
            elif event.unicode and len(self.name)<20: self.name+=event.unicode
        if self.btn_start.handle_event(event,self.game.sound,self.game.particles):
            self.game.after_delay(400,self._start)
        if self.btn_customize.handle_event(event,self.game.sound,self.game.particles):
            # Init a stub game state for customizer
            name=self.name.strip() or "Student"
            if not self.game.engine.state.players:
                self.game.engine.new_game(name,self.game.human_config)
            self.game.switch_scene("customize")
        if self.btn_quit.handle_event(event,self.game.sound,self.game.particles):
            self.game.quit()

    def update(self,dt):
        self._bt+=dt; self._ct+=dt; self._arch.update(dt,1)
        if self._ct>0.52: self._cursor=not self._cursor; self._ct=0
        for o in self.orbs:
            o["x"]+=o["dx"]; o["y"]+=o["dy"]
            if o["x"]<-o["r"] or o["x"]>W+o["r"]: o["dx"]*=-1
            if o["y"]<-o["r"] or o["y"]>H+o["r"]: o["dy"]*=-1
        for npc in NPC_SPRITES: get_anim(npc["name"]).update(dt,0)

    def draw(self,surf):
        # Architecture background
        self._arch.draw(surf,1,alpha_overlay=185)
        # Soft orbs
        for o in self.orbs:
            try:
                s=pygame.Surface((o["r"]*2,o["r"]*2),pygame.SRCALPHA)
                r2,g2,b2=o["col"]; pygame.draw.circle(s,(r2,g2,b2,o["a"]),(o["r"],o["r"]),o["r"])
                surf.blit(s,(int(o["x"]-o["r"]),int(o["y"]-o["r"])))
            except: pass

        cx=W//2; bob=math.sin(self._bt*1.1)*4
        _draw_text(surf,"HALL PASS",(cx,int(96+bob)),"big",C["accent"],"center")
        _draw_text(surf,"TO HELL",  (cx,int(148+bob)),"big",C["text"],"center")
        _draw_text(surf,"v4.0  ·  School Architecture  ·  Click Sounds  ·  Floor Gate  ·  Studs",
                   (cx,210),"small",C["text3"],"center")
        pygame.draw.line(surf,C["border"],(cx-280,232),(cx+280,232),1)

        lore=["Blackwell Vertical Academy. 100 floors. No exit.",
              "","Two of your classmates work for the school.",
              "They have always worked for the school.","","Find the truth."]
        y=244
        for ln in lore:
            _draw_text(surf,ln,(cx,y),"body",C["text2"] if ln else C["bg"],"center")
            y+=26 if ln else 8

        pygame.draw.line(surf,C["border"],(cx-280,y+4),(cx+280,y+4),1)
        _draw_text(surf,"Your name:",(cx,y+18),"small",C["text3"],"center")
        ir=pygame.Rect(cx-170,y+36,340,40)
        pygame.draw.rect(surf,C["surface2"],ir,border_radius=6)
        pygame.draw.rect(surf,C["accent"],ir,1,border_radius=6)
        _draw_text(surf,self.name+("|" if self._cursor else " "),(cx,y+44),"head",C["text"],"center")

        self.btn_start.draw(surf); self.btn_customize.draw(surf); self.btn_quit.draw(surf)

        # NPC row at bottom
        for i,npc in enumerate(NPC_SPRITES):
            nx=80+i*220; bob2=math.sin(self._bt*0.8+i)*3
            an=get_anim(npc["name"])
            SpriteFactory.draw_character(surf,npc,nx,H-148,height=78,bob_offset=bob2,anim=an)
            _draw_text(surf,npc["name"].split()[0],(nx+39,H-62),"tiny",C["text3"],"center")

    def _start(self):
        name=self.name.strip() or "Student"
        cfg=dict(self.game.human_config) if self.game.human_config else None
        self.game.engine.new_game(name,cfg)
        self.game.switch_scene("lobby")


class LobbyScene:
    def __init__(self,game):
        self.game=game; self._bt=0.0; self.school_map=SchoolMap()
        self._arch=SchoolArchitecture(); self._hb=0.0
        s=game.engine.state
        label=(f"Enter Floor {s.current_floor}" if s.phase=="task" else "Cast Your Vote")
        can_adv=game.engine.can_advance_floor() or s.current_floor==1
        cx=W//2+40
        self.btn_proceed=Button((cx-155,H-80,310,48),label,
                                "primary" if can_adv else "locked","head","nav")
        self.btn_proceed.disabled=not can_adv
        self.btn_customize=Button((20,H-58,150,36),"Customize","ghost","small","ui")
        self.btn_quit=Button((W-170,H-58,150,36),"Quit","ghost","small","ui")
        self._show_gate=not can_adv

    def handle_event(self,event):
        if self.btn_proceed.handle_event(event,self.game.sound,self.game.particles):
            if self.game.engine.can_advance_floor() or self.game.engine.state.current_floor==1:
                self.game.after_delay(320,self._proceed)
            else:
                self.game.sound.play("floor_locked",0.7)
                self._show_gate=True
        if self.btn_customize.handle_event(event,self.game.sound,self.game.particles):
            self.game.switch_scene("customize")
        if self.btn_quit.handle_event(event,self.game.sound,self.game.particles):
            self.game.quit()
        # Dismiss gate notice on any click
        if event.type==pygame.MOUSEBUTTONDOWN: self._show_gate=False

    def _proceed(self):
        s=self.game.engine.state
        self.game.switch_scene("vote" if s.phase=="vote" else "floor")

    def update(self,dt):
        self._bt+=dt; self._arch.update(dt,self.game.engine.state.current_floor)
        update_all_anims(dt,self.game.engine.state)
        if random.random()<0.04:
            self.game.particles.spawn_float(random.randint(400,W-50),H//2+random.randint(-80,80),C["accent"])
        s=self.game.engine.state; self._hb-=dt
        if self._hb<=0:
            for p in s.living_players():
                if p.suspicion>80:
                    self.game.sound.play("heartbeat",0.28)
                    self.game.particles.spawn_heartbeat(W//2+random.randint(-200,200),H//3)
                    self._hb=1.9; break

    def draw(self,surf):
        self._arch.draw(surf,self.game.engine.state.current_floor,alpha_overlay=170)
        s=self.game.engine.state

        _draw_text(surf,f"BLACKWELL ACADEMY — FLOOR {s.current_floor}",
                   (W//2,18),"head",C["accent"],"center")
        _draw_text(surf,
                   f"Clues: {s.clues_total}/{s.clues_needed}  ·  Tasks: {s.tasks_completed}  ·  Sabotages: {s.tasks_sabotaged}",
                   (W//2,48),"small",C["text2"],"center")

        # Floor gate status indicator
        can_adv=s.engine_can_adv if hasattr(s,"engine_can_adv") else self.game.engine.can_advance_floor()
        fl_done=s.current_floor in s.floor_task_done
        status_col=C["accent3"] if fl_done else C["warn"]
        status_txt="✓ Floor task complete — ready to advance" if fl_done else "⚠  Complete the floor mini-task before advancing"
        _draw_text(surf,status_txt,(W//2,70),"small",status_col,"center")

        pygame.draw.line(surf,C["border"],(30,88),(W-30,88),1)
        map_rect=pygame.Rect(22,96,320,445)
        self.school_map.draw(surf,s.current_floor,map_rect,s.visited_floors,s.floor_task_done)
        bar_r=pygame.Rect(28,546,308,10)
        _draw_sus_bar(surf,bar_r,min(100,int(s.clues_total/s.clues_needed*100)),C["accent3"])
        _draw_text(surf,f"Evidence: {s.clues_total}/{s.clues_needed}",(28,560),"tiny",C["text3"])

        rx=360; _draw_text(surf,"ROSTER",(rx,96),"small",C["text3"])
        pygame.draw.line(surf,C["border"],(rx,114),(W-22,114),1)
        CARD_H=78
        for i,player in enumerate(s.living_players()):
            cy=122+i*(CARD_H+7); cr=pygame.Rect(rx,cy,W-rx-22,CARD_H)
            _draw_panel(surf,cr,C["surface2"] if player.is_human else C["surface"])
            bob=math.sin(self._bt*1.5)*2 if player.is_human else 0
            an=get_anim(player.name)
            SpriteFactory.draw_character(surf,player.sprite_cfg,cr.x+6,cr.y+3,height=64,
                                         highlight=player.is_human,bob_offset=bob,anim=an,
                                         show_aura=True,sus=player.suspicion)
            nc=C["accent"] if player.is_human else C["text"]
            _draw_text(surf,("▶ " if player.is_human else "")+player.name,(cr.x+86,cy+8),"body",nc)
            _draw_text(surf,"(you)" if player.is_human else "NPC",(cr.x+86,cy+28),"tiny",C["text3"])
            sus=player.suspicion; sc=(C["accent3"] if sus<30 else C["warn"] if sus<60 else C["red"])
            br2=pygame.Rect(cr.x+86,cy+48,cr.w-96,8)
            _draw_sus_bar(surf,br2,sus,sc)
            _draw_text(surf,f"Sus {sus}%",(cr.right-6,cy+44),"tiny",sc,"right")
        ep=[p for p in s.players if not p.alive]
        if ep:
            ey=122+len(s.living_players())*(CARD_H+7)+6
            _draw_text(surf,"Ejected:",(rx,ey),"small",C["text3"]); ey+=16
            for p in ep:
                col=C["accent2"] if p.is_imposter() else C["text3"]
                _draw_text(surf,f"  {p.name}  [{'✓ imp' if p.is_imposter() else '✗ innocent'}]",
                           (rx,ey),"small",col); ey+=16

        pygame.draw.line(surf,C["border"],(30,H-92),(W-30,H-92),1)
        self.btn_proceed.draw(surf)
        self.btn_customize.draw(surf)
        self.btn_quit.draw(surf)
        if self._show_gate:
            _draw_floor_gate_notice(surf,s.current_floor)


class FloorScene:
    PHASES={1:"Trust Phase",2:"Trust Phase",3:"Trust Phase",
            4:"Doubt Phase",5:"Doubt Phase",6:"Doubt Phase",
            7:"Paranoia Phase",8:"Paranoia Phase",9:"No One Is Safe",10:"No One Is Safe"}
    def __init__(self,game):
        self.game=game; self._bt=0.0; self.school_map=SchoolMap()
        self._arch=SchoolArchitecture()
        s=game.engine.state
        self.task_buttons=[]
        for i in range(len(s.current_tasks)):
            by=142+i*150
            self.task_buttons.append(Button((380,by+100,min(W-408,380),38),
                                            f"Attempt: {s.current_tasks[i].title}",
                                            "primary","body","task"))
    def handle_event(self,event):
        s=self.game.engine.state
        for i,btn in enumerate(self.task_buttons):
            if btn.handle_event(event,self.game.sound,self.game.particles):
                chosen=s.current_tasks[i]
                self.game.after_delay(340,lambda c=chosen:self._attempt(c))
    def _attempt(self,chosen):
        s=self.game.engine.state; eng=self.game.engine; results=[]
        for task in s.current_tasks:
            result,msg=eng.resolve_task(task); results.append((task,result,msg))
            snd="success" if result==TaskResult.SUCCESS else "sabotage"
            self.game.sound.play(snd)
            if result==TaskResult.SABOTAGED: self.game.particles.spawn_suspicion_pulse(W//2,H//2)
        self.game.task_results=results; self.game.chosen_task=chosen
        self.game.switch_scene("task_result")
    def update(self,dt):
        self._bt+=dt; self._arch.update(dt,self.game.engine.state.current_floor)
        update_all_anims(dt,self.game.engine.state)
    def draw(self,surf):
        self._arch.draw(surf,self.game.engine.state.current_floor,alpha_overlay=175)
        s=self.game.engine.state
        _draw_text(surf,f"FLOOR {s.current_floor}",(W//2,14),"big",C["accent"],"center")
        _draw_text(surf,self.PHASES.get(s.current_floor,""),(W//2,68),"small",C["text3"],"center")
        _draw_text(surf,"Choose a task to attempt personally.",(W//2,90),"body",C["text2"],"center")
        pygame.draw.line(surf,C["border"],(30,116),(W-30,116),1)
        self.school_map.draw(surf,s.current_floor,pygame.Rect(22,126,318,395),
                             s.visited_floors,s.floor_task_done)
        for i,task in enumerate(s.current_tasks):
            ty=142+i*150; cr=pygame.Rect(378,ty,W-406,144)
            _draw_panel(surf,cr,C["surface2"] if task.tragic else C["surface"])
            if task.tragic: _draw_text(surf,"⚠ TRAGIC",(cr.right-8,ty+7),"tiny",C["warn"],"right")
            _draw_text(surf,task.title,(378+11,ty+7),"head",C["warn"] if task.tragic else C["text"])
            _draw_text(surf,f"[{task.location}]",(378+11,ty+30),"small",C["text3"])
            for d in range(5): pygame.draw.circle(surf,C["accent"] if d<task.difficulty else C["border"],(378+11+d*14,ty+52),4)
            _draw_text(surf,f"+{task.clues_reward} clues",(378+84,ty+46),"tiny",C["accent3"])
            _draw_text(surf,task.description,(378+11,ty+66),"small",C["text2"],max_width=cr.w-22)
            self.task_buttons[i].draw(surf)
        pygame.draw.line(surf,C["border"],(30,H-54),(W-30,H-54),1)
        fl_done=s.current_floor in s.floor_task_done
        gate_col=C["accent3"] if fl_done else C["warn"]
        gate_msg="✓ Mini-task done" if fl_done else "⚠ Mini-task required to advance"
        _draw_text(surf,f"Clues: {s.clues_total}/{s.clues_needed}  ·  Floor {s.current_floor}/{s.total_floors}  ·  {gate_msg}",
                   (W//2,H-40),"small",gate_col,"center")


class TaskResultScene:
    def __init__(self,game):
        self.game=game; cx=W//2
        self.btn_vote=Button((cx-270,H-80,250,48),"Call Emergency Vote","warn","head","vote")
        self.btn_minitask=Button((cx+20,H-80,250,48),"Floor Mini-Task  ★","success","head","task")

    def handle_event(self,event):
        if self.btn_vote.handle_event(event,self.game.sound,self.game.particles):
            self.game.engine.state.phase="vote"
            self.game.after_delay(300,lambda:self.game.switch_scene("vote"))
        if self.btn_minitask.handle_event(event,self.game.sound,self.game.particles):
            self.game.after_delay(300,lambda:self.game.switch_scene("mini_task"))

    def update(self,dt): pass

    def draw(self,surf):
        surf.fill(C["bg"]); s=self.game.engine.state
        results=getattr(self.game,"task_results",[]); chosen=getattr(self.game,"chosen_task",None)
        _draw_text(surf,"FLOOR REPORT",(W//2,20),"head",C["accent"],"center")
        _draw_text(surf,f"Floor {s.current_floor} — Task outcomes",(W//2,50),"small",C["text3"],"center")
        pygame.draw.line(surf,C["border"],(40,74),(W-40,74),1)
        CARD_H=138
        for i,(task,result,msg) in enumerate(results):
            cy=86+i*(CARD_H+10); cr=pygame.Rect(55,cy,W-110,CARD_H)
            is_sab=(result==TaskResult.SABOTAGED)
            bc=C["red"] if is_sab else C["accent3"]
            _draw_panel(surf,cr,C["surface2"] if is_sab else C["surface"])
            pygame.draw.rect(surf,bc,cr,2,border_radius=8)
            _draw_text(surf,"✗ SABOTAGED" if is_sab else "✓ SUCCESS",(cr.right-12,cy+8),"body",bc,"right")
            you=("  ← YOUR TASK" if task==chosen else "")
            _draw_text(surf,task.title+you,(cr.x+12,cy+8),"head",C["accent"] if task==chosen else C["text"])
            _draw_text(surf,f"[{task.location}]",(cr.x+12,cy+34),"small",C["text3"])
            _draw_text(surf,msg,(cr.x+12,cy+58),"body",C["text2"],max_width=cr.w-24)
        pygame.draw.line(surf,C["border"],(40,H-112),(W-40,H-112),1)
        _draw_text(surf,f"Total clues: {s.clues_total}/{s.clues_needed}",(W//2,H-102),"head",C["accent3"],"center")
        fl_done=s.current_floor in s.floor_task_done
        notice=("✓ Mini-task done — you may vote or advance."
                if fl_done else
                "⚠  You must complete the Floor Mini-Task before advancing.")
        _draw_text(surf,notice,(W//2,H-74),"small",C["accent3"] if fl_done else C["warn"],"center")
        self.btn_vote.draw(surf)
        self.btn_minitask.draw(surf)


class VoteScene:
    def __init__(self,game):
        self.game=game; self._bt=0.0; self._build()
    def _build(self):
        s=self.game.engine.state
        living=[p for p in s.living_players() if not p.is_human]
        self.vote_buttons=[]
        for i,player in enumerate(living):
            btn=Button((W-272,142+i*92+22,228,40),
                       f"Vote out {player.name.split()[0]}","danger","body","vote")
            self.vote_buttons.append((player,btn))
        self.btn_skip=Button((W//2-115,H-72,230,42),"Skip — don't vote","ghost","body","ui")
    def handle_event(self,event):
        for player,btn in self.vote_buttons:
            if btn.handle_event(event,self.game.sound,self.game.particles):
                self.game.after_delay(350,lambda p=player:self._cast(p))
        if self.btn_skip.handle_event(event,self.game.sound,self.game.particles):
            self.game.after_delay(300,self._skip)
    def _cast(self,target):
        eng=self.game.engine; s=eng.state; human=s.human_player()
        npc_v=eng.run_npc_votes(); all_v={**npc_v}
        if human: all_v[human.name]=target.name
        ejected=eng.resolve_vote(all_v); self._show(ejected,all_v)
    def _skip(self):
        npc_v=self.game.engine.run_npc_votes()
        ejected=self.game.engine.resolve_vote(npc_v); self._show(ejected,npc_v)
    def _show(self,ejected,all_votes):
        s=self.game.engine.state
        if ejected:
            ep=next((p for p in s.players if p.name==ejected),None)
            was_imp=ep and ep.is_imposter()
            self.game.pending_eject={"name":ejected,"was_imp":was_imp,"votes":all_votes}
            self.game.sound.play("eject_good" if was_imp else "eject_bad")
            self.game.particles.spawn_eject(W//2,H//2,was_imp)
        else:
            self.game.pending_eject={"name":None,"was_imp":False,"votes":all_votes}
        win=self.game.engine.check_win()
        if win is not None: self.game.after_delay(800,lambda:self.game.switch_scene("result"))
        else: self.game.after_delay(800,lambda:self.game.switch_scene("task_result"))
    def update(self,dt): self._bt+=dt; update_all_anims(dt,self.game.engine.state)
    def draw(self,surf):
        surf.fill(C["bg"]); s=self.game.engine.state
        _draw_text(surf,"EMERGENCY VOTE",(W//2,18),"title",C["warn"],"center")
        _draw_text(surf,"Who is working for the school?",(W//2,70),"body",C["text2"],"center")
        _draw_text(surf,"(Ties result in no ejection — which is also someone's plan.)",(W//2,94),"small",C["text3"],"center")
        pygame.draw.line(surf,C["border"],(40,118),(W-40,118),1)
        for i,(player,btn) in enumerate(self.vote_buttons):
            cy=142+i*92; cr=pygame.Rect(36,cy,W-72,84)
            _draw_panel(surf,cr,C["surface"])
            bob=math.sin(self._bt*1.2+i)*2; an=get_anim(player.name)
            SpriteFactory.draw_character(surf,player.sprite_cfg,cr.x+6,cr.y+3,height=64,
                                         bob_offset=bob,anim=an,show_aura=True,sus=player.suspicion)
            _draw_text(surf,player.name,(cr.x+88,cy+8),"head",C["text"])
            sus=player.suspicion; sc=(C["accent3"] if sus<30 else C["warn"] if sus<60 else C["red"])
            _draw_text(surf,f"Suspicion: {sus}%",(cr.x+88,cy+34),"small",sc)
            br2=pygame.Rect(cr.x+88,cy+54,310,7); _draw_sus_bar(surf,br2,sus,sc)
            flavor=next((n.get("flavor","") for n in NPC_SPRITES if n.get("name")==player.name),"")
            if flavor: _draw_text(surf,flavor,(cr.x+88,cy+64),"tiny",C["text3"])
            btn.draw(surf)
        pygame.draw.line(surf,C["border"],(40,H-82),(W-40,H-82),1)
        self.btn_skip.draw(surf)
        pe=getattr(self.game,"pending_eject",None)
        if pe and pe.get("name"):
            bc=C["accent3"] if pe["was_imp"] else C["red"]
            msg=(f"{pe['name']} ejected — WAS imposter ✓" if pe["was_imp"]
                 else f"{pe['name']} ejected — NOT imposter ✗")
            _draw_panel(surf,pygame.Rect(W//2-260,H//2-32,520,64),bc,radius=12,alpha=215)
            _draw_text(surf,msg,(W//2,H//2-14),"head",C["white"],"center")


class ResultScene:
    def __init__(self,game):
        self.game=game; self._t=0.0
        self.btn_replay=Button((W//2-145,H-72,290,48),"Play Again","primary","head","nav")
        s=game.engine.state
        game.sound.play("win" if s.students_win else "lose",0.7)
    def handle_event(self,event):
        if self.btn_replay.handle_event(event,self.game.sound,self.game.particles):
            self.game.after_delay(400,lambda:self.game.switch_scene("title"))
    def update(self,dt):
        self._t+=dt
        if random.random()<0.09:
            s=self.game.engine.state
            self.game.particles.spawn_float(random.randint(100,W-100),H-20,
                                            C["accent3"] if s.students_win else C["red"])
    def draw(self,surf):
        surf.fill(C["bg"]); s=self.game.engine.state
        if s.students_win:
            banner="BLACKWELL EXPOSED"; bc=C["accent3"]
            sub=(f"You found {s.clues_total} clues and survived {s.current_floor} floors.\n"
                 "The truth is out. The school is unbothered.\nIt's been here before.")
        else:
            banner="THE SCHOOL WINS"; bc=C["red"]
            sub=("The school has noticed your progress.\nThe school is unbothered.\nThe school was here before you.")
        pulse=abs(math.sin(self._t*2))*7
        _draw_text(surf,banner,(W//2,int(24+pulse)),"big",bc,"center")
        _draw_text(surf,sub,(W//2,96),"body",C["text2"],"center")
        pygame.draw.line(surf,C["border"],(40,168),(W-40,168),1)
        _draw_text(surf,"ROLE REVEAL",(W//2,178),"small",C["text3"],"center")
        for i,player in enumerate(s.players):
            ry=202+i*56; cr=pygame.Rect(55,ry,W-110,48)
            _draw_panel(surf,cr,C["surface2"] if player.is_imposter() else C["surface"])
            SpriteFactory.draw_character(surf,player.sprite_cfg,cr.x+5,cr.y+2,height=42,dead=not player.alive)
            nm=player.name+("  ← you" if player.is_human else "")+("  [ejected]" if not player.alive else "")
            _draw_text(surf,nm,(cr.x+56,ry+7),"body",C["text"])
            rc=C["red"] if player.is_imposter() else C["accent3"]
            _draw_text(surf,"IMPOSTER" if player.is_imposter() else "student",(cr.right-10,ry+10),"head",rc,"right")
        log_y=202+len(s.players)*56+8
        pygame.draw.line(surf,C["border"],(40,log_y),(W-40,log_y),1)
        _draw_text(surf,"GAME LOG",(58,log_y+7),"small",C["text3"])
        for j,entry in enumerate(s.log[-8:]):
            _draw_text(surf,entry,(58,log_y+24+j*15),"tiny",C["text3"])
        pygame.draw.line(surf,C["border"],(40,H-82),(W-40,H-82),1)
        self.btn_replay.draw(surf)


# ═══════════════════════════════════════════════════════════════════════
#  MAIN GAME
# ═══════════════════════════════════════════════════════════════════════

class Game:
    SCENE_MAP={
        "title":       TitleScene,
        "lobby":       LobbyScene,
        "floor":       FloorScene,
        "task_result": TaskResultScene,
        "vote":        VoteScene,
        "result":      ResultScene,
        "mini_task":   MiniTaskScene,
        "customize":   CustomizeScene,
    }

    def __init__(self):
        pygame.mixer.pre_init(SR,-16,1,512); pygame.init()
        self.screen=pygame.display.set_mode((W,H))
        pygame.display.set_caption(TITLE)
        self.clock=pygame.time.Clock()
        self._init_fonts()
        self.sound=SoundEngine(); self.particles=ParticleSystem()
        self.engine=GameEngine(); self.transition=Transition()
        self.task_results=[]; self.chosen_task=None; self.pending_eject=None
        self.human_config=dict(DEFAULT_PLAYER_CONFIG)
        self._deferred:List[Tuple[float,Any]]=[]
        self.scene=None
        self.switch_scene("title")
        self.sound.start_music()

    def _init_fonts(self):
        try:
            fn=pygame.font.match_font("couriernew,courier,freemono,monospace")
            sizes={"tiny":11,"small":13,"body":15,"head":19,"title":27,"big":44}
            for k,sz in sizes.items(): FONTS[k]=pygame.font.Font(fn,sz)
        except Exception:
            d=pygame.font.get_default_font()
            for k,sz in [("tiny",11),("small",13),("body",15),("head",19),("title",27),("big",44)]:
                FONTS[k]=pygame.font.Font(d,sz)

    def switch_scene(self,name:str):
        self.transition.start()
        cls=self.SCENE_MAP.get(name,TitleScene)
        self.scene=cls(self)

    def after_delay(self,ms:int,fn):
        self._deferred.append((time.time()+ms/1000.0,fn))

    def quit(self): pygame.quit(); raise SystemExit

    def run(self):
        running=True
        while running:
            dt=self.clock.tick(FPS)/1000.0
            for event in pygame.event.get():
                if event.type==pygame.QUIT: running=False
                elif event.type==pygame.KEYDOWN:
                    if event.key==pygame.K_ESCAPE: running=False
                    elif self.scene: self.scene.handle_event(event)
                elif self.scene: self.scene.handle_event(event)
            now=time.time(); rem=[]
            for at,fn in self._deferred:
                if now>=at:
                    try: fn()
                    except Exception: pass
                else: rem.append((at,fn))
            self._deferred=rem
            if self.scene: self.scene.update(dt)
            self.particles.update(); self.transition.update(dt)
            if self.scene: self.scene.draw(self.screen)
            self.particles.draw(self.screen)
            self.transition.draw(self.screen)
            pygame.display.flip()
        pygame.quit()


# ═══════════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ═══════════════════════════════════════════════════════════════════════

if __name__=="__main__":
    game=Game(); game.run()
