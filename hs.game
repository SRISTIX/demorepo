C = {
    "bg":       (12,  12,  18),
    "surface":  (22,  22,  34),
    "surface2": (32,  32,  52),
    "surface3": (42,  42,  68),
    "border":   (52,  52,  80),
    "accent":   (120, 112, 230),
    "accent2":  (210,  82,  44),
    "accent3":  (26,  152, 112),
    "warn":     (182, 112,  20),
    "text":     (228, 228, 240),
    "text2":    (140, 140, 172),
    "text3":    (82,   82, 116),
    "red":      (222,  70,  70),
    "white":    (255, 255, 255),
    "black":    (0,    0,   0),
    "yellow":   (238, 206,  56),
    "lime":     (116, 218,  74),
    "pink":     (218,  76, 158),
    "teal":     (36,  196, 196),
    "gold":     (212, 172,  48),
    "silver":   (192, 192, 208),
    "rose":     (220, 152, 152),
